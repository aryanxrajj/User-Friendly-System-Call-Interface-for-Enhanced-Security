{
    "whitelist": [
        "open", "read", "write", "close", "unlink", "rename", "mkdir", "rmdir",
        "socket", "connect", "bind", "listen", "accept", "send", "recv",
        "fork", "clone", "execve", "exit", "kill",
        "mmap", "munmap", "mprotect", "brk",
        "chmod", "chown", "setuid", "setgid",
        "pipe", "msgget", "semget", "shmget"
    ],
    "blacklist": [
        "ptrace", "mount", "umount", "init_module", "delete_module",
        "reboot", "kexec_load", "create_module", "pivot_root"
    ],
    "rate_limits": {
        "file_ops": 100,
        "network": 50,
        "process": 10,
        "general": 200
    }
}
